{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Dashboards": {
    "HighValueThresholdAlertUsd": 100000
  },
  "CacheTtls": {
    "Pipeline": "00:03:00",
    "Conversion": "00:15:00",
    "Aging": "00:05:00",
    "Detail": "00:05:00",
    "Summary": "00:05:00"
  }
}
